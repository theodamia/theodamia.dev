# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing
coverage
.nyc_output

# claude code local settings
.claude/settings.local.json

# camp artwork: full-size originals from the image generator stay local
/art/camps/raw/

# The forward climb's paintings, sheets and check composites stay local; guides, prompts and processed WebPs are reviewable.
/art/scene/flats/raw/*
/art/scene/flats/*.png
/art/scene/flats/check/
/art/scene/flats/edits/
/art/scene/style/**/*.png
/art/scene/review/

# The paintings behind /cv stay local too; their prompts (art/cv/*.md) and processed WebPs are reviewable.
/art/cv/raw/
# and the ones of /about (prompts in art/about/*.md)
/art/about/raw/
