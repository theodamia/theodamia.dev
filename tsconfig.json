{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  /* Next 16.4.3's dev type generator imports AppRouteHandlerRoutes and NextRequest whenever the app has
     metadata routes (the share cards, robots, sitemap) but writes no check that uses them, so
     noUnusedLocals fails `tsc` and `next build` once `next dev` has run. The pages are still checked:
     `next build` generates .next/types/validator.ts correctly. Drop this when Next fixes typegen.js. */
  "exclude": ["node_modules", ".next/dev/types/validator.ts"]
}
